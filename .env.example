# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Ephemeris Configuration
EPHEMERIS_PATH=./ephe

# Vedic Astrology Configuration
SIDEREAL_MODE=LAHIRI
NODE_RULERSHIP_STRATEGY=drik_compat
NAKSHATRA_EPSILON=1e-6

# Notes:
# - SIDEREAL_MODE options: LAHIRI (default), RAMAN, KRISHNAMURTI, YUKT_LAHIRI, VS_LAHIRI
# - NODE_RULERSHIP_STRATEGY: drik_compat (default), upagraha_dasa, sudha_graha
# - NAKSHATRA_EPSILON: Precision for nakshatra calculations (default 1e-6)
# - EPHEMERIS_PATH: Path to Swiss Ephemeris data files (relative or absolute)
